{
  "allowJs": true,
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2015",
    "lib": [
      "es2015",
      "dom"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "~~/*": [
        "./src/*"
      ],
      "@@/*": [
        "./src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    ".nuxt",
    "dist"
  ]
}